{
  "id": "stt",
  "name": "Speech Recognition",
  "version": "0.4.1",
  "description": "On-device STT (Moonshine) + cloud transcription, with a Speech Recognition settings tab and the cloud STT endpoint card.",
  "abi": 3,
  "permissions": [
    "events",
    "secrets",
    "microphone"
  ],
  "frontend": {
    "entry": "frontend.js"
  },
  "backend": {
    "library": "libstt_backend.dylib"
  },
  "versionCheckUrl": "https://github.com/companion-lab/companion-plugin-stt/releases/latest",
  "updateUrl": "https://github.com/companion-lab/companion-plugin-stt/releases/latest/download/stt-{version}-{platform}.zip"
}
